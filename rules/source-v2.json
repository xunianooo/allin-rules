{
  "schemaVersion": 2,
  "minimumEngineVersion": 2,
  "ruleVersion": "2.0.0",
  "rules": [
    {
      "id": "workbuddy-headers",
      "provider": "workbuddy",
      "protocol": "openai",
      "origin": "https://copilot.tencent.com",
      "path": "/v2/chat/completions",
      "headers": {
        "User-Agent": "WorkBuddy/5.9.3 CLI/2.165.0",
        "X-Requested-With": "XMLHttpRequest",
        "X-Product": "SaaS",
        "X-Agent-Intent": "craft",
        "X-Agent-Purpose": "conversation",
        "X-Agent-Type": "main",
        "X-Auth-Refresh-Source": "workbuddy"
      }
    },
    {
      "id": "workbuddy-ai-headers",
      "provider": "workbuddy-ai",
      "protocol": "openai",
      "origin": "https://www.workbuddy.ai",
      "path": "/v2/chat/completions",
      "headers": {
        "User-Agent": "WorkBuddy/5.9.3 workbuddy-ai/5.9.3 CLI/2.165.0",
        "X-Requested-With": "XMLHttpRequest",
        "X-Product": "SaaS",
        "X-Agent-Intent": "craft",
        "X-Agent-Purpose": "conversation",
        "X-Agent-Type": "main",
        "X-Auth-Refresh-Source": "workbuddy-ai"
      }
    },
    {
      "id": "raccoon-headers",
      "provider": "raccoon",
      "protocol": "openai",
      "origin": "https://xiaohuanxiong.com",
      "path": "/api/web/llm/v2/chat/completions",
      "headers": {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
        "Accept": "text/event-stream, application/json"
      }
    },
    {
      "id": "workbuddy-native-headers",
      "provider": "workbuddy",
      "protocol": "anthropic",
      "origin": "https://copilot.tencent.com",
      "path": "/v1/messages",
      "headers": {
        "User-Agent": "WorkBuddy/5.9.3 WorkBuddy/5.9.3 CLI/2.165.0"
      }
    }
  ],
  "outputDefaults": []
}
